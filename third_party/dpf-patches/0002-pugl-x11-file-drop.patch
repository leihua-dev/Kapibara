+static void
+sendXdndFinished(PuglView* const view, const bool accepted)
+{
+  PuglX11Clipboard* const board = &view->impl->clipboard;
+  const PuglX11Atoms* const atoms = &view->world->impl->atoms;
+  if (!board->source) {
+    return;
+  }
+  XEvent reply = {ClientMessage};
+  reply.xclient.display = view->world->impl->display;
+  reply.xclient.window = board->source;
+  reply.xclient.message_type = atoms->XdndFinished;
+  reply.xclient.format = 32;
+  reply.xclient.data.l[0] = (long)view->impl->win;
+  reply.xclient.data.l[1] = accepted ? 1L : 0L;
+  reply.xclient.data.l[2] = accepted ? (long)atoms->XdndActionCopy : None;
+  XSendEvent(view->world->impl->display, board->source, False, NoEventMask, &reply);
+}
+
+static bool
+handleXdndClientMessage(PuglView* const view, const XClientMessageEvent* const message)
+{
+  PuglX11Clipboard* const board = &view->impl->clipboard;
+  const PuglX11Atoms* const atoms = &view->world->impl->atoms;
+  Display* const display = view->world->impl->display;
+
+  if (message->message_type == atoms->XdndEnter) {
+    clearX11Clipboard(board);
+    board->selection = atoms->XdndSelection;
+    board->property = XA_PRIMARY;
+    board->source = (Window)message->data.l[0];
+
+    Atom localFormats[3] = {(Atom)message->data.l[2], (Atom)message->data.l[3],
+                            (Atom)message->data.l[4]};
+    Atom* formats = localFormats;
+    unsigned long numFormats = 3;
+    const bool hasTypeList = (message->data.l[1] & 1L) != 0;
+    if (hasTypeList && getAtomProperty(view, board->source, atoms->XdndTypeList,
+                                       &numFormats, &formats)) {
+      formats = localFormats;
+      numFormats = 3;
+    }
+    setClipboardFormats(view, board, numFormats, formats);
+    if (hasTypeList && formats != localFormats) {
+      XFree(formats);
+    }
+    board->acceptedFormatIndex = UINT32_MAX;
+    const PuglDataOfferEvent offer = {PUGL_DATA_OFFER, 0U, puglGetTime(view->world)};
+    PuglEvent event = {{PUGL_NOTHING, 0U}};
+    event.offer = offer;
+    puglDispatchEvent(view, &event);
+    return true;
+  }
+
+  if (message->message_type == atoms->XdndPosition) {
+    XEvent reply = {ClientMessage};
+    reply.xclient.display = display;
+    reply.xclient.window = board->source;
+    reply.xclient.message_type = atoms->XdndStatus;
+    reply.xclient.format = 32;
+    reply.xclient.data.l[0] = (long)view->impl->win;
+    reply.xclient.data.l[1] = board->acceptedFormatIndex < board->numFormats ? 1L : 0L;
+    reply.xclient.data.l[4] = board->acceptedFormatIndex < board->numFormats
+                                ? (long)atoms->XdndActionCopy : None;
+    XSendEvent(display, board->source, False, NoEventMask, &reply);
+    return true;
+  }
+
+  if (message->message_type == atoms->XdndDrop) {
+    if (board->acceptedFormatIndex < board->numFormats) {
+      const Time time = message->data.l[2] ? (Time)message->data.l[2] : CurrentTime;
+      XConvertSelection(display,
+                        atoms->XdndSelection,
+                        board->acceptedFormat,
+                        board->property,
+                        view->impl->win,
+                        time);
+    } else {
+      sendXdndFinished(view, false);
+    }
+    return true;
+  }
+
+  if (message->message_type == atoms->XdndLeave) {
+    clearX11Clipboard(board);
+    board->selection = atoms->CLIPBOARD;
+    board->property = XA_PRIMARY;
+    return true;
+  }
+
+  return false;
+}
