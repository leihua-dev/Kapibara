# Build products
build/
out/
cmake-build-*/
compile_commands.json
# third_party/DPF is a submodule (pinned upstream), not ignored — without it a
# fresh clone cannot build at all. Ignore anything else that lands here.
third_party/*
!third_party/DPF
!third_party/dpf-patches
*.exe
*.dll
*.lib
*.obj
*.pdb
*.ilk
*.exp
*.manifest

# IDE / local state
.vs/
.vscode/
*.user
*.suo
*.VC.db
*.VC.opendb

# Audio/editor scratch
*.wav
*.aif
*.aiff
*.flac
*.mp3
*.ogg
*.tmp
*.log

# OS noise
Thumbs.db
Desktop.ini
